# Serves the built SPA and reverse-proxies the API on the same origin, so the
# refresh-token cookie stays first-party and no CORS is needed in production.
# Rendered at container start by envsubst (only ${MAP_TILE_ORIGINS} is substituted).

server_tokens off;

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Reuse connections to the API instead of opening one per request. Without this,
# nginx runs out of ephemeral ports at ~2k req/s (found by loadtest/search.js).
upstream api_upstream {
  server api:8000;
  keepalive 64;
}

server {
  listen 8080;
  listen [::]:8080;
  server_name _;
  root /usr/share/nginx/html;
  client_max_body_size 3m;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # API: security headers come from the API itself (helmet).
  location /api/ {
    proxy_pass http://api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id $request_id;
  }

  location /socket.io/ {
    proxy_pass http://api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 1h;
  }

  location /uploads/ {
    proxy_pass http://api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    include /etc/nginx/conf.d/security-headers.inc;
  }

  # Hashed build assets never change: cache them for a year.
  location /assets/ {
    include /etc/nginx/conf.d/security-headers.inc;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # Client-side routing: unknown paths fall back to index.html (never cached).
  location / {
    include /etc/nginx/conf.d/security-headers.inc;
    add_header Cache-Control "no-cache" always;
    try_files $uri /index.html;
  }
}
