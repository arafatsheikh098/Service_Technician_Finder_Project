# Copy to .env for local development:  cp .env.example .env
NODE_ENV=development
PORT=8000
LOG_LEVEL=info

DATABASE_URL=postgres://techfinder:techfinder@localhost:5432/techfinder
REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# "queue" sends email via the worker (run `npm run dev:worker -w apps/api`); "log" just logs.
NOTIFICATIONS_DRIVER=queue
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="TechFinder <no-reply@techfinder.local>"

PAYMENT_WEBHOOK_SECRET=replace-me-with-a-random-webhook-secret

# Optional: enables AI problem triage. Without it, a keyword matcher is used.
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-opus-5-5

# Optional features. Unset = on in development, off in production.
# API_DOCS_ENABLED=true
# MOCKPAY_ENABLED=true

# Kill queries that run longer than this (ms)
DB_STATEMENT_TIMEOUT_MS=10000

# Optional: map tiles for the web build (default: public OpenStreetMap, dev/demo only)
# VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
