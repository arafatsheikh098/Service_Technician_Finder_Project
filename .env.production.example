# Production configuration for docker-compose.prod.yml.
#   cp .env.production.example .env.production   (never commit .env.production)
# Generate every secret with:   openssl rand -hex 32

# Public hostname. Caddy gets a Let's Encrypt certificate for it automatically;
# its DNS A/AAAA record must point at this server and ports 80/443 must be open.
DOMAIN=techfinder.example.com

POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_ACCESS_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Transactional email (any SMTP provider: Amazon SES, Mailgun, Brevo, Zoho…)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TechFinder <no-reply@techfinder.example.com>"

# Optional: AI problem triage. Without it a keyword matcher is used.
ANTHROPIC_API_KEY=

# Map tiles. The public OpenStreetMap servers forbid heavy production use;
# use a provider and list its origin for the Content-Security-Policy.
# Example (MapTiler):
#   VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
#   VITE_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
#   MAP_TILE_ORIGINS=https://api.maptiler.com
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
MAP_TILE_ORIGINS=https://*.tile.openstreetmap.org

# PostGIS image. The official one is amd64-only; on ARM servers use:
#   POSTGIS_IMAGE=imresamu/postgis:17-3.5
# POSTGIS_IMAGE=

# Sandbox gateway for public demos only. Keep false for real customers.
MOCKPAY_ENABLED=false
# Interactive API docs at /api/docs
API_DOCS_ENABLED=false
